{
  "model": "claude-opus-4-8",
  "availableModels": [
    "opus",
    "opus-4-8",
    "fable",
    "sonnet",
    "haiku"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dev/appa/agents/claude/hooks/block-no-verify.sh"
          },
          {
            "type": "command",
            "command": "$HOME/dev/appa/agents/claude/hooks/block-destructive-git.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/dev/appa/agents/claude/hooks/block-managed-file-edit.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "plannotator@plannotator": true,
    "slack@claude-plugins-official": true,
    "datadog@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    }
  },
  "feedbackDrafts": "off",
  "effortLevel": "medium",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "statusLine": {
    "type": "command",
    "command": "$HOME/.local/bin/appa statusline",
    "refreshInterval": 60
  }
}
