# The sold-rate-agent feedback loop as a managed service (replaces the Mac launchd
# the Mac feedback-loop agent). A oneshot batch job: it runs the conductor over the real
# feedback table for business-yesterday, posts the DEBUG digest, and exits; the box idles
# until the next timer fire. @@TOKENS@@ are rendered by config/services.sh.
#
# Runs via `mise exec` so the mise-managed uv/node AND the per-user npm-global agent CLIs
# (claude, pi) are on PATH. Env (Hermes home, worker runtime, Slack + Snowflake creds)
# comes from the 0600 EnvironmentFile the secrets phase writes on the data volume.
[Unit]
Description=Sold-Rate-Agent feedback loop (daily batch)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@@RUN_USER@@
Group=@@RUN_USER@@
Environment=HOME=@@TARGET_HOME@@
EnvironmentFile=@@ENV_FILE@@
WorkingDirectory=@@REPO_DIR@@
ExecStart=@@TARGET_HOME@@/.local/bin/mise exec -- uv run python -m scripts.sra_feedback_loop_daily
# The loop + its worker fan-out can run long; bound above a healthy run so systemd never
# kills it, and let the wrapper own the wall-clock skip.
TimeoutStartSec=19800
StandardOutput=append:@@LOG_DIR@@/feedback-loop.log
StandardError=append:@@LOG_DIR@@/feedback-loop.log
