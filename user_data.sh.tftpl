#!/bin/bash
set -euo pipefail
exec > >(tee -a /var/log/orb-bootstrap.log) 2>&1

# orb box boot bootstrap (minimal). Ubuntu LTS. Prepares a BARE box so orb's setup.sh
# — run afterwards as the default `ubuntu` user — can install the toolchain and the
# agent workstation on top. Deliberately tiny, so box provisioning stays generic:
#   1. base packages + aws CLI v2 (orb reads its secrets from SSM)
#   2. mount the durable EBS data volume, first-boot-safe (UUID fstab, nofail, format-if-empty)
# It creates NO extra user (orb runs as `ubuntu`), installs NO toolchain, and reads NO
# secrets — all of that is orb's job, on purpose.
#
# user_data runs ONCE; a mid-way abort half-provisions the box permanently. The one
# first-boot flaky — the dpkg lock (cloud-init / unattended-upgrades) — is wrapped in a
# bounded retry.

echo "orb-bootstrap: starting at $(date -u +%Y-%m-%dT%H:%M:%SZ)"

DATA_MOUNT="${data_mount}"

# apt-get with a dpkg-lock wait + retry: cloud-init's own package steps and
# apt-daily/unattended-upgrades routinely hold the lock for the first minutes of boot.
apt_get() {
  local attempt
  for attempt in $(seq 1 5); do
    if DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300 "$@"; then
      return 0
    fi
    echo "orb-bootstrap: apt-get $* failed (attempt $${attempt}/5); retrying in 15s"
    sleep 15
  done
  return 1
}

# ---------------------------------------------------------------------------
# 0. Clock. Non-fatal if the tz value is bad — the box still works in UTC.
# ---------------------------------------------------------------------------
timedatectl set-timezone "${timezone}" || echo "orb-bootstrap: WARN could not set timezone ${timezone}; staying on the default clock"

# ---------------------------------------------------------------------------
# 1. Base packages + aws CLI v2. openssh-server backs the SSM-tunnelled access;
#    there is no SSH ingress in the security group. aws CLI is present so orb's
#    preflight + secrets phases can read SSM immediately.
# ---------------------------------------------------------------------------
apt_get update -y
apt_get install -y curl git ca-certificates xz-utils rsync unzip jq openssh-server
systemctl enable --now ssh

# aws CLI v2 (Ubuntu does not ship it). Arch-aware; the EC2 t3 target is x86_64.
if ! command -v aws >/dev/null 2>&1; then
  AWS_ARCH="$(uname -m)"
  echo "orb-bootstrap: installing aws CLI v2 for $${AWS_ARCH}"
  TMP_AWS="$(mktemp -d)"
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$${AWS_ARCH}.zip" -o "$${TMP_AWS}/awscliv2.zip"
  unzip -q "$${TMP_AWS}/awscliv2.zip" -d "$${TMP_AWS}"
  "$${TMP_AWS}/aws/install"
  rm -rf "$${TMP_AWS}"
fi

# ---------------------------------------------------------------------------
# 2. Mount the durable EBS data volume at $${DATA_MOUNT} (first-boot-safe). The
#    attachment is /dev/sdf, but Ubuntu/nitro renames it; resolve the real device
#    from the volume id via the stable /dev/disk/by-id symlink.
# ---------------------------------------------------------------------------
VOLUME_ID="${ebs_volume_id}"
# nvme serial is the volume id with the dash stripped, e.g. vol-0abc -> vol0abc.
VOLUME_SERIAL="vol$${VOLUME_ID#vol-}"
BY_ID_LINK="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$${VOLUME_SERIAL}"

echo "orb-bootstrap: waiting for data volume $${VOLUME_ID} ($${BY_ID_LINK})"
for attempt in $(seq 1 30); do
  if [ -e "$${BY_ID_LINK}" ]; then
    break
  fi
  sleep 2
done
if [ ! -e "$${BY_ID_LINK}" ]; then
  echo "orb-bootstrap: ERROR data volume device $${BY_ID_LINK} never appeared" >&2
  exit 1
fi

DATA_DEVICE="$(readlink -f "$${BY_ID_LINK}")"
echo "orb-bootstrap: data volume resolved to $${DATA_DEVICE}"

# Format ONLY when the device has no filesystem — never reformat existing data.
if ! blkid "$${DATA_DEVICE}" >/dev/null 2>&1; then
  echo "orb-bootstrap: no filesystem on $${DATA_DEVICE} — creating ext4 (first boot)"
  mkfs.ext4 -L data "$${DATA_DEVICE}"
else
  echo "orb-bootstrap: existing filesystem on $${DATA_DEVICE} — preserving it"
fi

mkdir -p "$${DATA_MOUNT}"

# fstab by UUID (stable across device renaming) with nofail, so a missing volume
# never blocks boot. Append only if not already present.
DATA_UUID="$(blkid -s UUID -o value "$${DATA_DEVICE}")"
FSTAB_LINE="UUID=$${DATA_UUID} $${DATA_MOUNT} ext4 defaults,nofail 0 2"
if ! grep -qsF "UUID=$${DATA_UUID}" /etc/fstab; then
  echo "$${FSTAB_LINE}" >> /etc/fstab
  echo "orb-bootstrap: added fstab entry for $${DATA_UUID}"
fi

# Mount if not already mounted (mount -a honours the nofail fstab entry).
if ! mountpoint -q "$${DATA_MOUNT}"; then
  mount -a
fi
echo "orb-bootstrap: $${DATA_MOUNT} mounted"

# Hand the volume root to the ubuntu user so orb's setup.sh (run as ubuntu) can
# create its layout on it. orb's storage phase refines ownership within.
chown ubuntu:ubuntu "$${DATA_MOUNT}"

echo "orb-bootstrap: complete at $(date -u +%Y-%m-%dT%H:%M:%SZ) — run orb setup.sh as ubuntu to build the workstation"
